# --- 敏感项：本地 .env 或 Vercel 环境变量（勿提交真实 Key）---
TAVILY_API_KEY=
JINA_API_KEY=
OPENAI_API_KEY=
# MiniMax 国内版可选
# MINIMAX_GROUP_ID=

# --- 非敏感默认项：已写入 backend/config/deploy.defaults.json（随代码部署）---
# 本地开发可覆盖；Vercel 上一般无需再设 LLM_PROVIDER / OPENAI_MODEL / 提示词等
LLM_PROVIDER=openai
OPENAI_MODEL=deepseek-v4-pro
ORCHESTRATOR_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
# 各提示词分组默认绑定的实例（deploy key 或 stable id；留空则用 deploy.defaults.json）
# ORCHESTRATOR_INSTANCE_KEY=orchestrator
# REVIEW_INSTANCE_KEY=review_main
# ROUTER_INSTANCE_KEY=orchestrator
# SEARCH_INSTANCE_KEY=orchestrator
# ASSESSOR_INSTANCE_KEY=orchestrator
# PIPELINE_INSTANCE_KEY=orchestrator
LITPILOT_DATA_DIR=./data

# --- Turso 持久化 ---
# 本地：复制本文件为 .env（已 gitignore），填入真实 URL/Token，与 Vercel 使用相同变量名。
# Vercel：在后端项目 Dashboard 配置下列三项（冷启动锚点，不可仅靠管理员概览页）。
# LITPILOT_STORAGE_BACKEND=turso
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=
# 初始化 schema: cd backend && python3 scripts/turso_setup.py
# 导入本地 data: cd backend && python3 scripts/migrate_files_to_turso.py --data-dir ../data

# --- Vercel 后端环境变量（与本地 .env 键名一致）---
# LITPILOT_STORAGE_BACKEND=turso
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
# TAVILY_API_KEY=
# OPENAI_API_KEY=
# JINA_API_KEY=          # 可选
# MINIMAX_GROUP_ID=      # 可选
# LITPILOT_DATA_DIR=/tmp/litpilot-data
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
#
# --- Vercel：前端项目 ---
# BACKEND_URL=https://your-backend.vercel.app
