TAVILY_API_KEY=
JINA_API_KEY=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=MiniMax-M3
OPENAI_BASE_URL=https://api.openai.com/v1
# MiniMax 国内版可选（也可在设置页填写，非必填）
# MINIMAX_GROUP_ID=
LITPILOT_DATA_DIR=./data

# --- Vercel 部署（两个独立项目，见 README）---
# 后端项目环境变量：
# LITPILOT_DATA_DIR=/tmp/litpilot-data
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
# TAVILY_API_KEY=、OPENAI_API_KEY= 等（同上）
#
# 前端项目环境变量（必填，否则 /api/* 全部 404）：
# BACKEND_URL=https://your-backend.vercel.app
